# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# For a LOCAL run nothing here is required: generation defaults to llama3.1:8b
# via Ollama. The other keys unlock the Bedrock provider (hosted demo), the
# login gate, the guardrail judges, and tracing.

# --- LLM provider -----------------------------------------------------------
# "bedrock"  Amazon Nova Pro on AWS Bedrock — THE chosen generator (measured
#            better routing than local llama, ~5s answers, no GPU). Auth comes
#            from the IAM role (EC2) or `aws configure` (local dev). NEVER put
#            AWS access keys in this file.
# "ollama"   local llama3.1:8b — offline mode with no cloud account; the
#            baseline the system was built on. Also the fallback when unset.
LLM_PROVIDER=bedrock
AWS_REGION=ap-south-1
# Bedrock model ids: Amazon Nova Pro generates, Amazon Nova Lite is the guard
# fallback. In ap-south-1 Nova models only invoke through the `apac.` inference
# profile. Override for your region if `python -m agent.llm bedrock` reports a
# ValidationException.
# BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
# BEDROCK_GUARD_MODEL_ID=apac.amazon.nova-lite-v1:0

# --- Ollama (local LLM) -----------------------------------------------------
# Only set this if Ollama is not on the default host/port.
# OLLAMA_HOST=http://localhost:11434

# --- Deployment safety (Streamlit UI) ---------------------------------------
# Shared passcode for the login gate. REQUIRED — the UI refuses to start when
# this is empty rather than running open.
APP_PASSWORD=
# Per-session message cap and longest accepted message. Session-state based.
# MAX_MESSAGES_PER_SESSION=20
# MAX_INPUT_CHARS=2000

# --- Gemini (EVAL ONLY) -----------------------------------------------------
# Used as the RAGAS judge and as the default guardrail verifier backend. A
# DIFFERENT model from the answerer on purpose, so it can't grade itself.
# Get one at https://aistudio.google.com/apikey  (billing on = no RPM throttling)
GEMINI_API_KEY=

# Guardrail judge chain: "gemini" (default: Gemini -> Amazon Nova Lite on
# Bedrock -> fail closed), "bedrock" (Nova only), or "ollama" (local llama,
# an explicit opt-in for offline dev). If every judge in the chain is down the
# turn is REFUSED as unverifiable — never silently passed.
# GUARDRAIL_VERIFIER=gemini

# --- LangSmith tracing (optional) -------------------------------------------
# Leave blank to run fully offline — tracing silently no-ops without a key.
# Create a key at https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=

# Optional. The app auto-detects your region (US → EU → APAC) if this is unset;
# pinning it just skips that ~1-2s probe at startup.
#   US    https://api.smith.langchain.com      (default)
#   EU    https://eu.api.smith.langchain.com
#   APAC  https://apac.api.smith.langchain.com
# LANGSMITH_ENDPOINT=

# Project name shown in the LangSmith UI (defaults to "rag-build-agent").
# LANGSMITH_PROJECT=rag-build-agent
